# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is git-ignored.

# EOA private key used by the bundler API route (/api/send-userop) to call
# EntryPoint.handleOps. Server-side only — never exposed to the client.
# OPTIONAL: if left empty, the app falls back to having the connected wallet
# (MetaMask/WalletConnect) submit handleOps and pay gas itself — same as it
# already does when creating the wallet. Handy for local/self-host without
# running a bundler. The UserOp is still signed by WebAuthn either way.
BUNDLER_PRIVATE_KEY=0x...

# Etherscan API v2 key (used for transaction history proxy).
ARBISCAN_API_KEY=

# CoinGecko API key (optional — used for USD price lookups).
COINGECKO_API_KEY=

# Reown / WalletConnect project ID (public, used by the WalletConnect modal).
NEXT_PUBLIC_WC_PROJECT_ID=
