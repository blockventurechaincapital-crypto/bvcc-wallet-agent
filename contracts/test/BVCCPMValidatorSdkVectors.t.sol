pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {BVCCPositionManagerValidator} from "../src/BVCCPositionManagerValidator.sol";
import {BVCCHookRegistry} from "../src/BVCCHookRegistry.sol";

/// @dev Cross-check: real `modifyLiquidities` calldata produced by the @bvcc/agent-sdk
///      v4 builders (src/lp/v4.ts) must be accepted/denied exactly as intended by the
///      on-chain validator. Vectors generated with wallet 0x2222…, PM 0x1111…, no hook,
///      currencies 0x…aaaa / 0x…bbbb. If the SDK encoding drifts from what the
///      validator decodes, one of these flips and this suite catches it.
contract BVCCPMValidatorSdkVectorsTest is Test {
    BVCCPositionManagerValidator internal val;
    BVCCHookRegistry internal hooks;

    address internal constant PM = 0x1111111111111111111111111111111111111111;
    address internal constant WALLET = 0x2222222222222222222222222222222222222222;
    address internal constant ADMIN = 0x3145Bd5e2489d8bDdAb17F23F26F07Ac5aD55A4c;

    function setUp() public {
        hooks = new BVCCHookRegistry(ADMIN);
        val = new BVCCPositionManagerValidator(PM, address(hooks));
    }

    // ERC-20/ERC-20 mint (MINT_POSITION + SETTLE_PAIR), owner = wallet, no hook.
    function test_sdk_mint_erc20_accepted() public view {
        bytes memory data =
            hex"";
        assertTrue(val.validate(WALLET, PM, 0, data));
    }

    // Native mint (MINT + SETTLE_PAIR + SWEEP), value = 1000, currency0 = native.
    function test_sdk_mint_native_accepted() public view {
        bytes memory data =
            hex"";
        assertTrue(val.validate(WALLET, PM, 1000, data));
    }

    // Remove liquidity (DECREASE + TAKE_PAIR), recipient = wallet.
    function test_sdk_decrease_toWallet_accepted() public view {
        bytes memory data =
            hex"";
        assertTrue(val.validate(WALLET, PM, 0, data));
    }

    // Same decrease but TAKE_PAIR recipient = attacker → MUST be denied.
    function test_sdk_decrease_toAttacker_denied() public view {
        bytes memory data =
            hex"";
        assertFalse(val.validate(WALLET, PM, 0, data));
    }
}
